# Only needed to deploy or verify. The tests run without any of these.

# Alchemy key used for the RPC endpoints in hardhat.config.cjs
ALCHEMY_DEPLOY_API_KEY=

# Private key of the account that pays for the deployment
DEPLOYER_PRIVATE_KEY=

# Address that receives the service fee. It can never be changed after deployment.
FEE_WALLET=

# Set to true to deploy on a production network with a regular wallet as fee wallet
ALLOW_EOA_FEE_WALLET=

# For "npx hardhat verify"
ETHERSCAN_API_KEY=
