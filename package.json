{
  "name": "airdropsender-evm-contract",
  "version": "1.0.0",
  "description": "Smart contract behind the AirdropSender.com multisender for Ethereum, Base and BNB Smart Chain",
  "license": "MIT",
  "private": true,
  "homepage": "https://airdropsender.com",
  "scripts": {
    "compile": "hardhat compile",
    "test": "hardhat test",
    "deploy:sepolia": "hardhat run scripts/deploy.cjs --network sepolia",
